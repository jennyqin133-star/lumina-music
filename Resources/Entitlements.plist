<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Networking: required for MiniMax API + Sparkle update feed -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Audio input for humming/recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- User-selected audio files via NSOpenPanel -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Audio bookmarks for project files -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- App Sandbox: disabled for now (MVP) — switch to true for Mac App Store -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Allow JIT (Sparkle update installer) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (some audio frameworks need this) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading frameworks not signed by us (Sparkle.framework is signed by Sparkle project) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
